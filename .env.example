# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# NextAuth
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# Owner token secret (HMAC signing for owner auth cookies)
OWNER_TOKEN_SECRET=generate-a-random-secret-here

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Apify (scraping)
APIFY_TOKEN=apify_api_...

# ScrapingBee (scraping alternativo)
SCRAPINGBEE_API_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# Chrome path (Puppeteer - opcional, default /usr/bin/google-chrome)
CHROME_PATH=/usr/bin/google-chrome

# Cron secret (Vercel Cron Jobs)
CRON_SECRET=

# Resend (emails)
RESEND_API_KEY=re_...

# MercadoLibre OAuth
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Telegram notifications
TELEGRAM_NOTIFIER_URL=

# Supabase (if using Supabase client)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
